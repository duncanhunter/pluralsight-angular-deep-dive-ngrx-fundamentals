# NgRx 21 declares a peer dependency on @angular/core ^21, but this project runs
# Angular 22. NgRx 22 is not released yet, so we accept the (working) v21 packages.
# This lets a plain `npm install` succeed after a fresh `git clone`.
# Remove this file once NgRx 22 (with Angular 22 support) is released and adopted.
legacy-peer-deps=true
